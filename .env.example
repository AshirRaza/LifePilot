POSTGRES_DB=lifepilot
POSTGRES_USER=lifepilot
POSTGRES_PASSWORD=replace_with_a_strong_local_password
POSTGRES_PORT=5432

# URL-encode special characters in the password (e.g. ! -> %21).
# Prefer 127.0.0.1 over localhost on Windows — localhost may resolve to IPv6
# (::1) while Docker Postgres listens on IPv4 only, causing slow/hung connects.
DATABASE_URL=postgresql+psycopg://lifepilot:replace_with_a_strong_local_password@127.0.0.1:5432/lifepilot

# Isolated database for pytest (must end with _test). Optional: defaults to
# the DATABASE_URL with the database name replaced by lifepilot_test.
# Create once: docker compose exec postgres psql -U lifepilot -d postgres -c "CREATE DATABASE lifepilot_test"
# LIFEPILOT_TEST_DATABASE_URL=postgresql+psycopg://lifepilot:replace_with_a_strong_local_password@127.0.0.1:5432/lifepilot_test

# --- Agent / evidence orchestration (optional; defaults are safe for local/tests) ---
# LIFEPILOT_AGENT_MAX_QUESTION_LENGTH=4000
# LIFEPILOT_AGENT_MAX_EVIDENCE_ITEMS=20
# LIFEPILOT_AGENT_MAX_WORKFLOW_STEPS=16
# LIFEPILOT_AGENT_REQUEST_TIMEOUT_SECONDS=90
# LIFEPILOT_AGENT_EXTERNAL_TIMEOUT_SECONDS=30
# LIFEPILOT_AGENT_MAX_EXTERNAL_CONCURRENCY=3
# LIFEPILOT_AGENT_MAX_LLM_OUTPUT_TOKENS=2048
# LIFEPILOT_AGENT_DEFAULT_TOP_K=8
# LIFEPILOT_AGENT_MAX_TOP_K=20
# Automatic hybrid retrieval is the default agent behavior (external_mode=auto).
# Explicit controls on AgentRequest.retrieval:
#   external_mode=auto  — curated KB + selective official verification (default)
#   external_mode=off   — internal-only (benchmarks / reproducible evals)
#   external_mode=on    — always combine approved connectors
# Legacy include_external=true|false still maps to on|off.
# Deprecated: thin-internal external calls are covered by external_mode=auto.
# LIFEPILOT_AGENT_EXTERNAL_FALLBACK=0
#
# Knowledge-base maintenance (scripts/run_knowledge_maintenance.py):
#   Dry-run by default. Use --execute for bounded unattended rechecks.
#   Material/uncertain changes are queued for human review; not auto-verified.
#   Schedule via Task Scheduler/cron/CI — no Celery/Airflow dependency.
#
# Anthropic Claude (answer generation). Never commit real keys.
# ANTHROPIC_API_KEY=replace_with_anthropic_api_key
# LIFEPILOT_LLM_PROVIDER=anthropic
# LIFEPILOT_LLM_MODEL=claude-sonnet-5-5
# LIFEPILOT_LLM_TIMEOUT_SECONDS=45
# LIFEPILOT_LLM_MAX_RETRIES=2
# LIFEPILOT_LLM_MAX_CONCURRENCY=2
# LIFEPILOT_LLM_MAX_EVIDENCE_ITEMS=12
# LIFEPILOT_LLM_MAX_CHARS_PER_PASSAGE=1200
# LIFEPILOT_LLM_MAX_CONTEXT_CHARS=14000
# Optional explicit USD pricing per million tokens (0 disables estimates).
# Claude Sonnet 5.5 Anthropic list (verify before paid runs): input $2 / output $10 per MTok.
# LIFEPILOT_LLM_INPUT_COST_PER_MTOK=2
# LIFEPILOT_LLM_OUTPUT_COST_PER_MTOK=10
#
# Grounded Q&A evaluation budgets (scripts/run_grounded_qa_eval.py):
# LIFEPILOT_EVAL_MAX_CALLS=55
# LIFEPILOT_EVAL_MAX_COST_USD=5
# LIFEPILOT_EVAL_CONCURRENCY=1
# LIFEPILOT_EVAL_MAX_RETRIES=2
# LIFEPILOT_EVAL_DEADLINE_SECONDS=7200
# LIFEPILOT_EVAL_MAX_INPUT_TOKENS=2000000
# LIFEPILOT_EVAL_MAX_OUTPUT_TOKENS=500000
#
# Optional live smoke flags (off by default):
# LIFEPILOT_LIVE_EXTERNAL=1
# LIFEPILOT_LIVE_ANTHROPIC=1
